<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="NuGet metadata">
    <PackageId>Hlibz.OpenApi.Paging</PackageId>
    <Description>Publishes Hlibz.Paging in OpenAPI documents built with Microsoft.AspNetCore.OpenApi: a [SortableBy] parameter or property says what it sorts by, the format and the default order, which is also its schema's default.</Description>
    <PackageTags>openapi;aspnetcore;minimal-api;paging;sorting</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Hlibz.Paging" />
  </ItemGroup>

  <!-- Packed as a dependency on the same version: every package here is released together. -->
  <ItemGroup>
    <ProjectReference Include="..\Hlibz.OpenApi.AspNetCore\Hlibz.OpenApi.AspNetCore.csproj" />
  </ItemGroup>

  <!--
    Microsoft.AspNetCore.OpenApi's XML comment generator reaches this project through
    Hlibz.OpenApi.AspNetCore and would compile this library's own doc comments into it, so it is
    taken off the compiler's analyzers, as Hlibz.OpenApi.AspNetCore does.
  -->
  <Target Name="RemoveOpenApiXmlCommentGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Hlibz.OpenApi.Paging.Tests" />
  </ItemGroup>

</Project>
