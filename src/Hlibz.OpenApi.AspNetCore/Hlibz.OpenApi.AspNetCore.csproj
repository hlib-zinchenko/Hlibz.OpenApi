<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="NuGet metadata">
    <PackageId>Hlibz.OpenApi.AspNetCore</PackageId>
    <Description>Transformers for Microsoft.AspNetCore.OpenApi: XML summaries as descriptions, read at runtime so internal types and NuGet packages are covered (AddXmlDocumentation), custom validation attributes that describe themselves in the schema (IOpenApiRule), strongly-typed IDs published as their inner value (inline, or kept as components), the 400 that AddValidation() answers with on exactly the operations it can come from (AddValidationProblems), a bearer (or any) security scheme marked on exactly the endpoints that require authorization, StyleCop's "Gets or sets" wording stripped from descriptions, and several OpenAPI documents registered in one call, one per endpoint group.</Description>
    <PackageTags>openapi;aspnetcore;minimal-api;transformers;validation;strongly-typed-ids;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!--
    Microsoft.AspNetCore.OpenApi's XML comment generator would compile this library's own doc
    comments (a cache and transformers nothing calls) into the package, so it is taken off the
    compiler's analyzers. ExcludeAssets="analyzers" doesn't stop it.
  -->
  <Target Name="RemoveOpenApiXmlCommentGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

  <!--
    Apps get that generator through this package even without a direct reference to
    Microsoft.AspNetCore.OpenApi, but not the property that lets its interceptors compile; this
    target sets it for them (buildTransitive, so it reaches indirect consumers too).
  -->
  <ItemGroup>
    <None Include="buildTransitive\Hlibz.OpenApi.AspNetCore.targets"
          Pack="true"
          PackagePath="buildTransitive" />
  </ItemGroup>

  <!--
    XML documentation is found next to each assembly; in a single-file app assemblies have no
    location. The analyzer keeps any other use of Assembly.Location from slipping in.
  -->
  <PropertyGroup>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hlibz.OpenApi.AspNetCore.Tests" />
  </ItemGroup>

</Project>
