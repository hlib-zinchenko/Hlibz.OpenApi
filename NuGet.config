<?xml version="1.0" encoding="utf-8"?>
<!--
  Until the .NET 11 majors ship, the Hlibz packages they build on (Hlibz.Results 3.0 and the rest)
  come from a local folder feed. Remove the local source once they are on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="%HOME%/LocalNuGet" />
  </packageSources>
</configuration>
