<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Sample-only: the endpoint and ReDoc packages the sample app is built with. -->
        <PackageVersion Include="Hlibz.MinimalApi.Endpoints" Version="1.0.0-preview.5" />
        <PackageVersion Include="Hlibz.Redoc.AspNetCore" Version="2.3.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

    <!--
        One Microsoft.AspNetCore.OpenApi major per target framework: 10.x is built on
        Microsoft.OpenApi 2.x, 11.x on 3.x. Both are minimums: packed as ">=" dependencies, so an
        app picks any newer patch itself.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    </ItemGroup>
</Project>
